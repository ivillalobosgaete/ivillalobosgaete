# Copia este archivo como .env (solo para pruebas locales) o carga estas variables en Vercel:
# Project > Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-clave-service_role

# Texto largo y aleatorio para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Administrador inicial: se crea solo la primera vez que alguien inicia sesión.
ADMIN_USER=ivillalobos
ADMIN_PASSWORD=escribe-aqui-la-contraseña

# Solo para probar en http://localhost sin HTTPS (no usar en producción)
# COOKIE_INSECURE=1
