# Copiar como .env en el equipo local. Este archivo con valores reales NO se sube al repositorio.
# Usuario de solo visualización creado en cada grabador Dahua (no usar admin).
CAM_USER=
# Contraseñas de ese usuario en cada equipo. Si tienen símbolos como @ : / # ?, escribirlos codificados (por ejemplo @ = %40).
CAM_PASS_1=
CAM_PASS_2=
# Credenciales que la plataforma usará para pedir las imágenes (inventarlas; las mismas van en Vercel).
RELAY_USER=
RELAY_PASS=
# Token del túnel creado en Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
